# Copy this file to .env and fill in real values.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PORT=8000

# --- Inbound auth: a random static key you generate yourself (e.g. `uuidgen`
# or `openssl rand -hex 16`), not a provider credential. Required by clients
# in the X-API-Key header on /claims/*. Unset = every request is rejected. ---
APP_API_KEY=

# --- Database: MongoDB Atlas free-tier connection string (recommended,
# no Docker needed), a local mongod, or Azure Cosmos DB for MongoDB vCore
# in production. Same wire protocol, same code either way. ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB_NAME=claims_assistant

# --- OpenAI: required. Used for both the agent's function-calling loop
# and RAG embeddings (text-embedding-3-small) -- there is no offline /
# stub mode, this app needs a real key to run at all. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- RAG ---
RAG_TOP_K=3

# --- Fraud heuristic thresholds ---
FRAUD_HIGH_AMOUNT_THRESHOLD=500000
FRAUD_EARLY_CLAIM_DAYS_THRESHOLD=30
FRAUD_FREQUENCY_LOOKBACK_DAYS=365
FRAUD_FREQUENCY_CLAIM_COUNT_THRESHOLD=3
